{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puerta1-ecuador1438",
  "main": "worker.js",
  "compatibility_date": "2026-09-09"

  // ── Secrets Telegram (NO van en este archivo; cárgalos con la CLI o el dashboard):
  //      wrangler secret put TELEGRAM_BOT_TOKEN
  //      wrangler secret put TELEGRAM_CHAT_ID
  //    TELEGRAM_BOT_TOKEN → Token del bot de Telegram
  //    TELEGRAM_CHAT_ID   → Chat/ID de destino en Telegram

  // ── Credenciales Cloudflare Calls / Realtime SFU (los entregados por SFU):
  //    Se aceptan ambos nombres (el Worker resuelve con fallback):
  //      wrangler secret put ID_app            → App/Application ID de Cloudflare Calls
  //      wrangler secret put Token_API         → App Secret (API Token) de Cloudflare Calls
  //    o los nombres convencionales de Cloudflare Meet:
  //      wrangler secret put CALLS_APP_ID
  //      wrangler secret put CALLS_APP_SECRET
  //    TURN opcional (recomendado para redes estrictas):
  //      wrangler secret put SFU_TURN_SERVICE_ID
  //      wrangler secret put SFU_TURN_SERVICE_TOKEN

  // ── KV opcional (recomendado) para límites del timbre y para el
  //    emparejamiento de la videollamada (viewer ↔ puerta):
  //    "kv_namespaces": [
  //      { "binding": "TIMBRE_KV", "id": "ID_NAMESPACE_TIMBRE" },
  //      { "binding": "PAIR_KV",   "id": "ID_NAMESPACE_PAIR"   }
  //    ]
  //    El Worker usa PAIR_KV para /pair* y, si no existe, cae a
  //    TIMBRE_KV. Sin ninguna de las dos sigue funcionando, pero el
  //    emparejamiento queda solo en memoria del isolate y se pierde
  //    cuando Cloudflare enruta el POST del visor y el GET de la
  //    puerta a isolates distintos (llamada inversa intermitente).
  //    Crear la namespace:  wrangler kv namespace create PAIR_KV
}