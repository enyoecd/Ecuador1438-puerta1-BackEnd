{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puerta1-ecuador1438",
  "main": "worker.js",
  "compatibility_date": "2026-09-09"

  // ────────── Cámara / Cloudflare Calls SFU ──────────────────────
  //
  // 1) Secrets (NO van en este archivo; cárgalos con la CLI o el dashboard):
  //      wrangler secret put ID_app
  //      wrangler secret put Token_API
  //    ID_app     → App ID de Cloudflare Calls (Realtime SFU)
  //    Token_API  → Token de la app de Cloudflare Calls
  //    (TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID ya existen en Cloudflare)
  //
  // 2) Variables no secretas a configurar en Cloudflare antes del deploy:
  //    ALLOWED_ORIGINS  → origen exacto de Pages, separado por comas si hay más de uno.
  //                        Ej.: https://<tu-proyecto>.pages.dev
  //    El enlace del visor se deriva siempre del Origin HTTPS de la solicitud
  //    que llega desde Cloudflare Pages; no se configura una URL fija.

  // 3) KV obligatorio en producción para estado de cámara y límites de timbre:
  //    "kv_namespaces": [
  //      { "binding": "CAMERA_STATE", "id": "ID_NAMESPACE_CAMARA" },
  //      { "binding": "TIMBRE_KV",    "id": "ID_NAMESPACE_TIMBRE" }
  //    ]
}
